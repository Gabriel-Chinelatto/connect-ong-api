# MODELO de configuracao local.
# 1. Copie este arquivo para "application-local.properties" (mesma pasta).
# 2. Preencha a senha real do banco.
# O arquivo "application-local.properties" NAO vai para o Git (esta no .gitignore),
# entao a senha nunca mais fica exposta no repositorio.

DB_PASSWORD=coloque_a_senha_aqui

# Segredo do JWT (OBRIGATORIO). O JwtService nao tem mais valor default:
# sem esta propriedade a aplicacao FALHA no startup (de proposito).
# - Local: defina aqui um segredo forte e aleatorio (>= 256 bits / ~40+ chars).
# - Producao: NAO ponha em arquivo; defina a variavel de ambiente APP_JWT_SECRET
#   (o Spring mapeia APP_JWT_SECRET -> app.jwt.secret automaticamente).
app.jwt.secret=coloque_um_segredo_forte_e_aleatorio_aqui

# Opcional: tambem da para sobrescrever a URL e o usuario, se precisar.
# DB_URL=jdbc:mysql://143.106.241.3:3306/cl203161
# DB_USERNAME=cl203161
